# ============================================================
# 环境变量模板 —— 复制为 .env 并填入真实值（切勿提交真实 .env）
#   cp .env.example .env
# ============================================================

# ===== AI 配置（DeepSeek）=====
DEEPSEEK_API_KEY=sk-你的密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
AI_REQUEST_TIMEOUT=60

# ===== 数据库 =====
# 开发（SQLite）：sqlite:///./data/assessment.db
# 生产（PostgreSQL）：postgresql://legal_ai_user:<密码>@db:5432/legal_ai_assessment
DATABASE_URL=sqlite:///./data/assessment.db

# ===== 安全（JWT）=====
SECRET_KEY=请改成至少32字节的强随机字符串
REFRESH_SECRET_KEY=请改成另一个强随机字符串
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 运行环境 =====
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
LOG_LEVEL=INFO

# ===== 文件与存储 =====
DATA_DIR=./data
MAX_FILE_SIZE_MB=10
FILE_RETENTION_DAYS=30
MAX_STORAGE_MB=500

# ===== 生产部署额外变量（docker-compose）=====
# POSTGRES_PASSWORD=<强密码>   ← 必填：compose 启动时强制校验（未设置会直接报错）
# POSTGRES_USER=legal_ai_user
# POSTGRES_DB=legal_ai_assessment
